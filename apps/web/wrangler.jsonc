{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-09-26",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "grn-web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	// Keep variables/secrets set in the Cloudflare dashboard (PAYLOAD_API_URL, PAYLOAD_API_KEY)
	// across Git-triggered deploys instead of wiping them.
	"keep_vars": true
}
